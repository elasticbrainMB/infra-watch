{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git rebase *)",
      "Bash(git commit --amend*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git rebase *)",
      "PowerShell(git commit --amend*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f *)",

      "Bash(docker restart *)",
      "Bash(docker stop *)",
      "Bash(docker start *)",
      "Bash(docker rm *)",
      "Bash(docker pull *)",
      "Bash(docker run *)",
      "Bash(docker update *)",
      "Bash(docker compose *)",
      "PowerShell(docker restart *)",
      "PowerShell(docker stop *)",
      "PowerShell(docker start *)",
      "PowerShell(docker pull *)",
      "PowerShell(docker run *)",
      "PowerShell(docker rm *)",
      "PowerShell(docker update *)",
      "PowerShell(docker compose *)"
    ],

    "ask": [
      "Edit(scripts/**)",

      "Bash(git commit *)",
      "PowerShell(git commit *)",

      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(rm *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "PowerShell(Rename-Item *)",
      "PowerShell(Move-Item *)",
      "PowerShell(Copy-Item *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(New-Item *)",
      "PowerShell(Set-Content *)",
      "PowerShell(Add-Content *)",
      "PowerShell(Out-File *)"
    ],

    "allow": [
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(sha256sum *)",
      "Bash(md5sum *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git cat-file *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git rev-parse *)",
      "Bash(git blame *)",
      "Bash(ollama list *)",
      "Bash(ollama ps *)",
      "Bash(ollama show *)",
      "Bash(ollama --version *)",
      "Bash(nvidia-smi *)",
      "Bash(docker ps *)",
      "Bash(docker inspect *)",
      "Bash(docker version *)",

      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-Item *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Select-String *)",
      "PowerShell(Get-FileHash *)",
      "PowerShell(Measure-Object *)",
      "PowerShell(Get-WinEvent *)",
      "PowerShell(Get-EventLog *)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git show *)",
      "PowerShell(git cat-file *)",
      "PowerShell(ollama list *)",
      "PowerShell(ollama ps *)",
      "PowerShell(ollama show *)",
      "PowerShell(ollama --version *)",
      "PowerShell(nvidia-smi *)",
      "PowerShell(docker ps *)",
      "PowerShell(docker inspect *)",
      "PowerShell(docker version *)",

      "Edit(records/**)",
      "Edit(config/**)"
    ]
  }
}
